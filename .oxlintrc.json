{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "react-hooks"],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "perf": "off"
  },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/target/**",
    "**/gen/**",
    "**/vendor/**",
    "**/*.d.ts",
    ".claude/**"
  ]
}
