{
  "productName": "Kaya",
  "version": "0.4.3",
  "identifier": "com.kaya.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "category": "Game",
    "copyright": "Copyright © 2025-2026 Hadim",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "Play, study, and analyze Go with AI-powered analysis (KataGo), board recognition from photos, and a modern interface. Free and open source.",
    "shortDescription": "Go game with AI analysis and board recognition",
    "resources": {
      "scripts/pytorch_inference.py": "scripts/pytorch_inference.py",
      "../public/assets/move-0.ogg": "sounds/move-0.ogg",
      "../public/assets/move-1.ogg": "sounds/move-1.ogg",
      "../public/assets/move-2.ogg": "sounds/move-2.ogg",
      "../public/assets/move-3.ogg": "sounds/move-3.ogg",
      "../public/assets/move-4.ogg": "sounds/move-4.ogg",
      "../public/assets/capture0.ogg": "sounds/capture0.ogg",
      "../public/assets/capture1.ogg": "sounds/capture1.ogg",
      "../public/assets/capture2.ogg": "sounds/capture2.ogg",
      "../public/assets/capture3.ogg": "sounds/capture3.ogg",
      "../public/assets/capture4.ogg": "sounds/capture4.ogg",
      "../public/assets/pass.ogg": "sounds/pass.ogg",
      "../public/assets/newgame.ogg": "sounds/newgame.ogg"
    },
    "macOS": {
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kaya",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "endpoints": ["https://github.com/kaya-go/kaya/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEQjg3MUJGN0I1MDk1MDgKUldRSWxWQjd2M0c0YmRxdjVpalNZbHFaeTgxbXpueEhOTXVuYW51U09Sd0diRVVDY24zRGtaTUgK"
    }
  }
}
