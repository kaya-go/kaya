{
  "name": "@kaya/web",
  "version": "0.4.17",
  "private": true,
  "description": "Kaya web application",
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "bun run --cwd ../.. generate-version-info && bun run --cwd ../.. copy-assets && bun run --cwd ../.. build:packages && rsbuild build",
    "preview": "rsbuild preview",
    "type-check": "tsc --build --force",
    "lint": "eslint src --ext ts,tsx"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@dagrejs/graphlib": "^4.0.7",
    "@kaya/gametree": "workspace:*",
    "@kaya/goboard": "workspace:*",
    "@kaya/sgf": "workspace:*",
    "@kaya/shudan": "workspace:*",
    "@kaya/ui": "workspace:*",
    "coi-serviceworker": "^0.1.7",
    "i18next": "^26.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.11",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.3.0",
    "@rsbuild/plugin-react": "^2.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
