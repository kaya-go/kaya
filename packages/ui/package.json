{
  "name": "@kaya/ui",
  "version": "0.4.4",
  "description": "Shared UI components for Kaya",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/styles/ui.css": "./dist/styles/ui.css",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@dagrejs/graphlib": "^4.0.1",
    "@kaya/ai-engine": "workspace:*",
    "@kaya/boardmatcher": "workspace:*",
    "@kaya/deadstones": "workspace:*",
    "@kaya/game-library": "workspace:*",
    "@kaya/gametree": "workspace:*",
    "@kaya/i18n": "workspace:*",
    "@kaya/platform": "workspace:*",
    "@kaya/themes": "workspace:*",
    "@kaya/goboard": "workspace:*",
    "@kaya/sgf": "workspace:*",
    "@kaya/shudan": "workspace:*",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-http": "^2.5.7",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "elkjs": "^0.11.1",
    "gamecontroller.js": "^1.5.0",
    "i18next": "^26.0.3",
    "jszip": "^3.10.1",
    "react-arborist": "^3.4.3",
    "react-i18next": "^17.0.2",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "reactflow": "^11.11.4",
    "remark-gfm": "^4.0.1",
    "@kaya/board-recognition": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^6.0.2"
  }
